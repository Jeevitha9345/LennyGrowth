# The Lenny Growth Assistant - Configuration Template
# Copy this file to .env and adjust variables as needed.

# ==============================================================================
# 1. APPLICATION ENVIRONMENT
# ==============================================================================
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# 2. AI MODEL PROVIDER CONFIGURATION
# ==============================================================================
# Active Provider: "ollama" | "openai" | "anthropic" | "mock" (for zero-cost deterministic testing)
ACTIVE_PROVIDER=mock

# Local Ollama Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=15.0

# Cloud OpenAI Settings (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20.0

# Cloud Anthropic Settings (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_TIMEOUT_SECONDS=20.0

# Generation Parameters (Bounded for strict ~1GB RAM constraints)
MAX_RESPONSE_TOKENS=1024
TEMPERATURE=0.3
TOP_K_CHUNKS=4
MAX_CONTEXT_CHAR_LIMIT=4000

# ==============================================================================
# 3. DATABASE & PERSISTENCE (Supabase Hosted PostgreSQL with SQLite fallback)
# ==============================================================================
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
# Fallback local SQLite file path used only when DATABASE_URL is empty or unreachable
SQLITE_FALLBACK_PATH=./data/lenny_growth.db

# ==============================================================================
# 4. KNOWLEDGE BASE & RETRIEVAL
# ==============================================================================
TRANSCRIPTS_DIR=./data/transcripts
CHUNKS_CACHE_FILE=./data/processed/chunks_cache.json
TFIDF_MAX_FEATURES=5000
MIN_RELEVANCE_SCORE=0.15
